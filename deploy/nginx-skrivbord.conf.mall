# Mall: deploy.sh ersätter @DOMAN@, @PORT@ och @BRYGGA_PORT@. Läggs bara in om
# sajten saknas — certbot skriver sedan in https-delen i samma fil.
server {
    server_name @DOMAN@;
    listen 80;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    # 46elks websocket-samtal → bryggan. Upgrade-huvudena måste skickas vidare,
    # annars blir det vanlig HTTP och 46elks lägger på direkt.
    location = /elks {
        proxy_pass http://127.0.0.1:@BRYGGA_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        # Ett samtal är högst två minuter (agentens max_duration_seconds).
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        proxy_pass http://127.0.0.1:@PORT@;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Long-poll från enheten väntar upp till 25 s; agentens anrop tills bordet stannat.
        proxy_read_timeout 90s;
    }
}
