# Kopiera till deploy/deploy.env (gitignorerad) eller exportera variablerna i skalet.
# Servern nås med ssh och användaren behöver lösenordsfri sudo (sudo -n).
SKRIVBORD_SERVER=[FYLL I: användare@server, t.ex. deploy@example.com]
SKRIVBORD_DOMAN=[FYLL I: domän, t.ex. bord.example.com]
CERTBOT_EPOST=[FYLL I: e-post för Let's Encrypt-meddelanden]
# Valfritt — standardvärdena står i deploy.sh.
# SKRIVBORD_ANVANDARE=deploy
# SKRIVBORD_MAL=/home/deploy/skrivbord
# SKRIVBORD_PORT=8550
# SKRIVBORD_BRYGGA_PORT=8551
# SKRIVBORD_PYTHON=python3.12
